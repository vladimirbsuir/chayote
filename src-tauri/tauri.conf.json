{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chayote",
  "version": "0.1.0",
  "identifier": "com.chayote.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chayote",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 520,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "app", "dmg", "deb", "appimage"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDAwQ0EzNzQ4RkIyNzU0NUUKUldSZVZDZjdTRGZLQUc5UkVMdEl6bWEreE5zZVdpMzUwUjk1eTgwNTk3SUhLUkJDQng4RDN1NzkK",
      "endpoints": [
        "https://github.com/vladimirbsuir/chayote/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      },
      "requireSignedVersion": true
    }
  }
}
